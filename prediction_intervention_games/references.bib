  abstract = {We consider the regression setting where observations are collected from multiple environments corresponding to different data distributions. Machine learning methods relying on Empirical Risk Minimization (ERM) assume that training and test data are independent and identically dis- tributed, and may therefore fail to generalize beyond the environments observed during training. In the multi-environment setting, the field of Out-Of-Distribution (OOD) Generalization aims to design methods that are robust to distribution shifts, for instance by minimizing the maximum risk across environments. We follow this principle and introduce MaxRM (Maximum Risk Min- imization) Random Forest, a modification of Random Forest that minimizes the maximum risk across the observed training environments rather than the pooled risk over all observations. We consider three definitions of risk: the Mean Squared Error (MSE); the negative reward, which relates to the explained variance; and the regret, which quantifies the excess risk relative to the best predictor. While the aggregation of trees is the same as in standard Random Forest, the con- struction of individual trees differs, and we propose three strategies to partition the input space and assign values to the resulting regions. We provide alternative optimization algorithms for one of these strategies, establish theoretical guarantees, and evaluate our methods with experi- ments on both simulated and real-world data. Finally, we show how to apply the maximum risk minimization framework to smoothing splines.},
  school = {ETH Zurich},
  keywords = {DG,OOD,random forest,robustness,status:to-read},
