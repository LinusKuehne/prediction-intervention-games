@misc{pfisterKernelbasedTestsJoint2016,
  title = {Kernel-Based {{Tests}} for {{Joint Independence}}},
  author = {Pfister, Niklas and B{\"u}hlmann, Peter and Sch{\"o}lkopf, Bernhard and Peters, Jonas},
  year = 2016,
  month = nov,
  number = {arXiv:1603.00285},
